# Kormiis environment template — copy to .env and fill with real values.
# NEVER commit the real .env file.

# Firebase (Project settings > General > Your apps > SDK setup and configuration)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Google Identity Services / Sign-In client
VITE_GOOGLE_CLIENT_ID=

# Firebase Cloud Messaging Web Push certificate key (Project settings > Cloud Messaging)
VITE_FIREBASE_VAPID_KEY=

# Gemini AI
VITE_GEMINI_API_KEY=

# Resend email API (dev proxy + production sender)
VITE_RESEND_API_KEY=
