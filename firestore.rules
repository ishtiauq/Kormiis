rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin(adminUid) {
      return request.auth != null && request.auth.uid == adminUid;
    }

    // An employee is a registered company member (anonymous session)
    function isMember(adminUid) {
      return request.auth != null
        && exists(/databases/$(database)/documents/companies/$(adminUid)/members/$(request.auth.uid));
    }

    // A workspace owner is a user whose users/{uid} doc either has no
    // companyUid (legacy owners) or has companyUid === their own uid.
    // Teammates have companyUid set to the owner's uid, so they fail both.
    function isWorkspaceOwner() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && (
          !('companyUid' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data)
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyUid == request.auth.uid
        );
    }

    // Company profile doc — the workspace owner (admin) reads/writes it.
    match /companies/{adminUid} {
      allow read, write: if isAdmin(adminUid);
    }

    // Company data snapshots: admin + registered members can read/write.
    // This powers real-time sync across all devices.
    match /companies/{adminUid}/snapshots/{document=**} {
      allow read: if isAdmin(adminUid) || isMember(adminUid);
      allow write: if isAdmin(adminUid) || isMember(adminUid);
    }

    // WhatsApp outbox — LEGACY. The app now uses the 1-Click wa.me mode
    // (no Cloud Function / Blaze). wa_outbox is kept read-only for any
    // historical records; clients no longer write here.
    match /companies/{adminUid}/wa_outbox/{msgId} {
      allow read: if isAdmin(adminUid) || isMember(adminUid);
      allow create, update, delete: if false;
    }

    // WhatsApp credentials (Meta access token etc.) — LEGACY server-only.
    // Unused in 1-Click mode (no Cloud Function needs them).
    match /companies/{adminUid}/secrets/{secretDoc} {
      allow read, write: if false;
    }

    // Global phone-number-id -> company routing map — LEGACY server-only.
    // Unused in 1-Click mode.
    match /wa_routing/{phoneNumberId} {
      allow read, write: if false;
    }

    // WhatsApp opt-ins + delivery log live inside snapshots (see the
    // snapshots rule above), so clients can read/write them without Blaze.

    // Employee auth snapshot — readable by any authenticated (incl. anonymous)
    // user so employees can verify credentials from any device before they
    // become registered members. Only the admin can write it.
    match /companies/{adminUid}/auth/employees {
      allow read: if request.auth != null;
      allow write: if isAdmin(adminUid);
    }

    // Company membership registry — employees register themselves on login.
    match /companies/{adminUid}/members/{employeeUid} {
      allow read: if isAdmin(adminUid) || request.auth.uid == employeeUid;
      allow write: if isAdmin(adminUid) || request.auth.uid == employeeUid;
    }

    // Users collection:
    // 1) Users can read/write their own document
    // 2) Authenticated users can read user docs to check workspace links
    // 3) Workspace owners can write user records to provision teammates
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.auth.uid == userId || isWorkspaceOwner());
    }

    // Email invites — workspace owners invite teammates by email; the invite
    // lets that exact email address auto-link to the company on first Google
    // sign-in.
    match /invites/{email} {
      allow read, write: if request.auth != null;
    }
  }
}
