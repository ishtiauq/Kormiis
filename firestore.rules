rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin(adminUid) {
      return request.auth != null && request.auth.uid == adminUid;
    }

    // An employee is a registered company member (anonymous session)
    function isMember(adminUid) {
      return request.auth != null
        && exists(/databases/$(database)/documents/companies/$(adminUid)/members/$(request.auth.uid));
    }

    // A workspace owner is a user whose users/{uid} doc either has no
    // companyUid (legacy owners) or has companyUid === their own uid.
    // Teammates have companyUid set to the owner's uid, so they fail both.
    function isWorkspaceOwner() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && (
          !('companyUid' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data)
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyUid == request.auth.uid
        );
    }

    // The caller's own role / company, if their users doc exists.
    function callerRole() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'Teammate')
        : 'Teammate';
    }

    function callerCompanyUid() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('companyUid', '')
        : '';
    }

    function isPrivileged() {
      return request.auth != null && callerRole() in ['Admin', 'HR'];
    }

    // Workspace owner, or an Admin/HR member of that workspace.
    function isAdminOrHR(adminUid) {
      return isAdmin(adminUid) || (isMember(adminUid) && isPrivileged());
    }

    // Roles a user may self-assign on first registration (never Admin).
    function selfRoleAllowed() {
      return request.resource.data.get('role', 'Teammate') != 'Admin';
    }

    // Company profile doc — the workspace owner (admin) reads/writes it.
    match /companies/{adminUid} {
      allow read, write: if isAdmin(adminUid);
    }

    // Company data snapshots: members sync real-time. All tables are writable
    // by registered members EXCEPT `settings`, which holds workspace secrets
    // (API keys, device registry) and is restricted to Admin roles only.
    match /companies/{adminUid}/snapshots/{document} {
      allow read: if isAdmin(adminUid) || isMember(adminUid);
      allow write: if isAdmin(adminUid)
        || (isMember(adminUid) && (document != 'settings' || callerRole() == 'Admin'));
    }

    // WhatsApp outbox — LEGACY. The app now uses the 1-Click wa.me mode
    // (no Cloud Function / Blaze). wa_outbox is kept read-only for any
    // historical records; clients no longer write here.
    match /companies/{adminUid}/wa_outbox/{msgId} {
      allow read: if isAdmin(adminUid) || isMember(adminUid);
      allow create, update, delete: if false;
    }

    // WhatsApp credentials (Meta access token etc.) — LEGACY server-only.
    // Unused in 1-Click mode (no Cloud Function needs them).
    match /companies/{adminUid}/secrets/{secretDoc} {
      allow read, write: if false;
    }

    // Global phone-number-id -> company routing map — LEGACY server-only.
    // Unused in 1-Click mode.
    match /wa_routing/{phoneNumberId} {
      allow read, write: if false;
    }

    // WhatsApp opt-ins + delivery log live inside snapshots (see the
    // snapshots rule above), so clients can read/write them without Blaze.

    // Employee auth snapshot — readable by any authenticated (incl. anonymous)
    // user so employees can verify credentials from any device before they
    // become registered members. Only the admin can write it.
    match /companies/{adminUid}/auth/employees {
      allow read: if request.auth != null;
      allow write: if isAdmin(adminUid);
    }

    // Company membership registry — employees register themselves on login,
    // but a member may never change their own role (no self-promotion).
    match /companies/{adminUid}/members/{employeeUid} {
      allow read: if isAdmin(adminUid) || request.auth.uid == employeeUid;
      allow create: if isAdminOrHR(adminUid)
        || (request.auth.uid == employeeUid && selfRoleAllowed());
      allow update: if isAdminOrHR(adminUid)
        || (request.auth.uid == employeeUid
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']));
      allow delete: if isAdminOrHR(adminUid);
    }

    // Users collection:
    // 1) Users can read user docs to check workspace links
    // 2) Owners / Admin / HR provision and manage user records
    // 3) A user may edit their own doc but NOT their own role
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && (
        isWorkspaceOwner()
        || (isPrivileged() && request.resource.data.get('companyUid', '') == callerCompanyUid())
        || (request.auth.uid == userId && (
              request.resource.data.get('companyUid', '') == userId || selfRoleAllowed()
           ))
      );
      allow update: if request.auth != null && (
        isWorkspaceOwner()
        || (isPrivileged() && resource.data.companyUid == callerCompanyUid())
        || (request.auth.uid == userId
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']))
      );
      allow delete: if isWorkspaceOwner();
    }

    // Email invites — workspace owners invite teammates by email; the invite
    // lets that exact email address auto-link to the company on first Google
    // sign-in.
    match /invites/{email} {
      allow read, write: if request.auth != null;
    }
  }
}
